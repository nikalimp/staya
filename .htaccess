# HTTPS включается галочкой в ISPmanager. Редирект по %{HTTPS} здесь не пишем:
# на REG.RU nginx снимает TLS перед Apache, и такое правило даёт бесконечный цикл 301.

AddType application/javascript .js .mjs
AddType application/json .json
AddType model/gltf-binary .glb
AddType image/webp .webp
AddType image/svg+xml .svg
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json model/gltf-binary
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 30 days"
  ExpiresByType audio/mpeg "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>
