# HTTPS включается галочкой в ISPmanager. Редирект по %{HTTPS} здесь не пишем:
# на REG.RU nginx снимает TLS перед Apache, и такое правило даёт бесконечный цикл 301.

AddType application/javascript .js .mjs
AddType application/json .json
AddType model/gltf-binary .glb
AddType image/webp .webp
AddType image/svg+xml .svg
AddType video/mp4 .mp4
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json model/gltf-binary
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>
# index.html всегда свежий: ресурсы лежат в папке версии a-<хэш>/ и кэшируются на год (см. scripts/build.mjs)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
